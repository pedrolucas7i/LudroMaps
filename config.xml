<?xml version="1.0" encoding="utf-8"?>
<widget id="com.pedrolucas7i.ludromaps" xmlns="http://www.w3.org/ns/widgets" version="1.0.0">
  <name>LudroMaps</name>
  <description>A Maps App</description>

  <!-- Splash Screen Settings --> 
  <preference name="SplashScreenDelay" value="2000" />
  <preference name="AutoHideSplashScreen" value="true" />
  <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/splashTemplate.jpg" />
  <preference name="AndroidWindowSplashScreenBackground" value="#ffffff" />

  <!-- App Icon -->
  <icon src="resources/iconTemplate.jpg" />

  <!-- Cordova Plugins -->
  <plugin name="cordova-plugin-device" />

  <!-- Access Permissions -->
  <access origin="*" />
</widget>
